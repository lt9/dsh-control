# dsh-control 环境变量样例。全部占位值——站点事实（域名/入口 IP/面板地址）
# 的正式来源是 `cli seed --site deploy/site.toml` 写进 credentials(kind=site)，
# 这里只做兜底。凭据值放 env 变量名，私钥文件放 env_file 指向的路径。

# ---- 必填 ----
# 生产用 PostgreSQL；本地试跑可用 sqlite+aiosqlite
DSHC_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/dsh_control
# 会话签名密钥：随便一串长随机（openssl rand -hex 32）
DSHC_SESSION_SECRET=change-me-openssl-rand-hex-32

# ---- 监听 ----
DSHC_LISTEN_HOST=0.0.0.0
DSHC_LISTEN_PORT=13300
DSHC_SESSION_DAYS=7

# ---- 站点事实（推荐 seed 灌库；示例用文档保留网段占位）----
DSHC_PUBLIC_BASE=https://console.example.com
DSHC_INGRESS_IP=203.0.113.10
# NG 回源用哪个地址连 frps（必填才能开通）。NG 若为 host 网络通常填 127.0.0.1；
# 不能填公网入口 IP——云上无 NAT 回环，入口机自己访问自己的公网 IP 不通。
DSHC_FRPS_UPSTREAM_HOST=198.51.100.9
DSHC_DNS_ZONE=example.com
DSHC_DNS_PREFIX=dsh-
# frps 公网端口搜索起点
DSHC_FRP_PORT_START=20000
# 自动选主机时机械盘优先
DSHC_PREFER_HDD=true
# 默认部署镜像标签（准备好的版本；开通阶段永不构建，20 步会在目标机核验在位，
# 不在就用 cli images ship 搬）
DSHC_IMAGE=registry.local/dsh:stable
# 主控台自身所在主机（hosts.name 或 ssh_host；hosts 恰好一台 enabled 时可留空）
DSHC_CONSOLE_HOST=
# NG 建站用的现成通配证书名（留空走适配器默认）
DSHC_WILDCARD_CERT_NAME=

# ---- provider 选择（noop = 该层人工做，部署步骤标 skipped 并打印人工清单）----
DSHC_PROVIDER_DNS=noop
DSHC_PROVIDER_FRP=noop
DSHC_PROVIDER_NG=noop

# ---- 面板/DNS 凭据 env 兜底（正式来源：seed 写进 credentials）----
DSHC_ALIYUN_AK=
DSHC_ALIYUN_SK=
DSHC_FRP_PANEL_URL=
DSHC_FRP_PANEL_USER=
DSHC_FRP_PANEL_PASS=
DSHC_NG_URL=
DSHC_NG_USER=
DSHC_NG_PASS=

# ---- watcher / 状态机 ----
# 备份窗口：窗口内不做自动重启（容器备份会闪断健康）
DSHC_BACKUP_WINDOW=03:20-04:00
# 自动重启冷却秒数（连续 unhealthy 阈值固定 3，见契约 §3）
DSHC_RESTART_COOLDOWN=600
DSHC_POLL_INTERVAL=30
DSHC_WAIT_HEALTHY_SECONDS=120

# ---- 模型：对推理服务真实在服务的模型名（别名只给旧客户端兼容用）----
DSHC_LLM_MODEL_ID=Qwen3.8-Flash-Next

# ---- 生图：DSH 没有原生生图入口，控制台把技能铺进实例的 skills/ ----
# 主入口（内网优先）与备用入口；token 是 credentials 里 kind=image_key 的那条
DSHC_IMAGE_API_URL=http://192.0.2.20:8188
DSHC_IMAGE_BACKUP_URL=http://198.51.100.2:23400

# 智能体团队人数上限（官方默认 8，家庭机器建议 4）
DSHC_TEAM_MAX_MEMBERS=4

